{
    "name": "pl_billings_raw_to_bronze",
    "properties": {
        "activities": [
            {
                "name": "lk_get_bronze_history",
                "type": "Lookup",
                "dependsOn": [],
                "policy": {
                    "timeout": "0.12:00:00",
                    "retry": 0,
                    "retryIntervalInSeconds": 30,
                    "secureOutput": false,
                    "secureInput": false
                },
                "userProperties": [],
                "typeProperties": {
                    "source": {
                        "type": "AzureSqlSource",
                        "sqlReaderQuery": {
                            "value": "SELECT REPLACE(BatchName, '.json','') AS BatchName\nFROM AuditLog\nWHERE Status = 'Bronze_Completed'\nAND TableName = 'Billings'",
                            "type": "Expression"
                        },
                        "queryTimeout": "02:00:00",
                        "partitionOption": "None"
                    },
                    "dataset": {
                        "referenceName": "ds_sql_control_table",
                        "type": "DatasetReference"
                    },
                    "firstRowOnly": false
                }
            },
            {
                "name": "md_list_raw_files",
                "type": "GetMetadata",
                "dependsOn": [
                    {
                        "activity": "lk_get_bronze_history",
                        "dependencyConditions": [
                            "Succeeded"
                        ]
                    }
                ],
                "policy": {
                    "timeout": "0.12:00:00",
                    "retry": 0,
                    "retryIntervalInSeconds": 30,
                    "secureOutput": false,
                    "secureInput": false
                },
                "userProperties": [],
                "typeProperties": {
                    "dataset": {
                        "referenceName": "ds_generic_json",
                        "type": "DatasetReference",
                        "parameters": {
                            "p_folder": "billings_api",
                            "p_filename": "*",
                            "p_container": "raw"
                        }
                    },
                    "fieldList": [
                        "childItems"
                    ],
                    "storeSettings": {
                        "type": "AzureBlobFSReadSettings",
                        "recursive": true,
                        "enablePartitionDiscovery": false
                    },
                    "formatSettings": {
                        "type": "JsonReadSettings"
                    }
                }
            },
            {
                "name": "fl_indentity_new_batches",
                "type": "Filter",
                "dependsOn": [
                    {
                        "activity": "md_list_raw_files",
                        "dependencyConditions": [
                            "Succeeded"
                        ]
                    }
                ],
                "userProperties": [],
                "typeProperties": {
                    "items": {
                        "value": "@activity('md_list_raw_files').output.childItems",
                        "type": "Expression"
                    },
                    "condition": {
                        "value": "@not(\n    contains(\n        string(activity('lk_get_bronze_history').output.value),\n        replace(item().name,'.json','')\n    )\n)",
                        "type": "Expression"
                    }
                }
            },
            {
                "name": "fr_each_medications",
                "type": "ForEach",
                "dependsOn": [
                    {
                        "activity": "fl_indentity_new_batches",
                        "dependencyConditions": [
                            "Succeeded"
                        ]
                    }
                ],
                "userProperties": [],
                "typeProperties": {
                    "items": {
                        "value": "@activity('fl_indentity_new_batches').output.value",
                        "type": "Expression"
                    },
                    "activities": [
                        {
                            "name": "sc_log_start",
                            "type": "Script",
                            "dependsOn": [],
                            "policy": {
                                "timeout": "0.12:00:00",
                                "retry": 0,
                                "retryIntervalInSeconds": 30,
                                "secureOutput": false,
                                "secureInput": false
                            },
                            "userProperties": [],
                            "linkedServiceName": {
                                "referenceName": "ls_azure_sqldb",
                                "type": "LinkedServiceReference"
                            },
                            "typeProperties": {
                                "scripts": [
                                    {
                                        "type": "Query",
                                        "text": {
                                            "value": "@concat(\n'IF EXISTS (SELECT 1 FROM Auditlog \nWHERE TableName = ''Billings'' \nAND BatchName = ''', replace(item().name,'.json',''), ''')\nBEGIN\n    UPDATE Auditlog\n    SET Status = ''InProgress'', StartTime = GETDATE()\n    WHERE TableName = ''Billings'' \n    AND BatchName = ''', replace(item().name,'.json',''), '''\nEND\nELSE\nBEGIN\n    INSERT INTO Auditlog (TableName, BatchName, Status, Layer, StartTime)\n    VALUES (''Billings'', ''', replace(item().name,'.json',''), ''', ''InProgress'', ''Bronze'', GETDATE())\nEND'\n)",
                                            "type": "Expression"
                                        }
                                    }
                                ],
                                "scriptBlockExecutionTimeout": "02:00:00"
                            }
                        },
                        {
                            "name": "cp_raw_to_bronze",
                            "type": "Copy",
                            "dependsOn": [
                                {
                                    "activity": "sc_log_start",
                                    "dependencyConditions": [
                                        "Succeeded"
                                    ]
                                }
                            ],
                            "policy": {
                                "timeout": "0.12:00:00",
                                "retry": 0,
                                "retryIntervalInSeconds": 30,
                                "secureOutput": false,
                                "secureInput": false
                            },
                            "userProperties": [],
                            "typeProperties": {
                                "source": {
                                    "type": "JsonSource",
                                    "storeSettings": {
                                        "type": "AzureBlobFSReadSettings",
                                        "recursive": true,
                                        "enablePartitionDiscovery": false
                                    },
                                    "formatSettings": {
                                        "type": "JsonReadSettings"
                                    }
                                },
                                "sink": {
                                    "type": "ParquetSink",
                                    "storeSettings": {
                                        "type": "AzureBlobFSWriteSettings"
                                    },
                                    "formatSettings": {
                                        "type": "ParquetWriteSettings"
                                    }
                                },
                                "enableStaging": false
                            },
                            "inputs": [
                                {
                                    "referenceName": "ds_generic_json",
                                    "type": "DatasetReference",
                                    "parameters": {
                                        "p_folder": "billings_api",
                                        "p_filename": {
                                            "value": "@item().name",
                                            "type": "Expression"
                                        },
                                        "p_container": "raw"
                                    }
                                }
                            ],
                            "outputs": [
                                {
                                    "referenceName": "ds_generic_parquet",
                                    "type": "DatasetReference",
                                    "parameters": {
                                        "p_container": "bronze",
                                        "p_folder": "billings",
                                        "p_filename": {
                                            "value": "@replace(item().name, '.json', '.parquet')",
                                            "type": "Expression"
                                        }
                                    }
                                }
                            ]
                        },
                        {
                            "name": "sc_update_bronze_status",
                            "type": "Script",
                            "dependsOn": [
                                {
                                    "activity": "sc_mark_processed",
                                    "dependencyConditions": [
                                        "Succeeded"
                                    ]
                                }
                            ],
                            "policy": {
                                "timeout": "0.12:00:00",
                                "retry": 0,
                                "retryIntervalInSeconds": 30,
                                "secureOutput": false,
                                "secureInput": false
                            },
                            "userProperties": [],
                            "linkedServiceName": {
                                "referenceName": "ls_azure_sqldb",
                                "type": "LinkedServiceReference"
                            },
                            "typeProperties": {
                                "scripts": [
                                    {
                                        "type": "Query",
                                        "text": {
                                            "value": "@concat(\n'UPDATE Auditlog \nSET Status = ''Bronze_Completed'', \n    Layer = ''Bronze'', \n    EndTime = GETDATE()\nWHERE TableName = ''Billings'' \nAND BatchName = ''', replace(item().name,'.json',''), ''''\n)",
                                            "type": "Expression"
                                        }
                                    }
                                ],
                                "scriptBlockExecutionTimeout": "02:00:00"
                            }
                        },
                        {
                            "name": "sc_mark_processed",
                            "type": "Script",
                            "dependsOn": [
                                {
                                    "activity": "cp_raw_to_bronze",
                                    "dependencyConditions": [
                                        "Succeeded"
                                    ]
                                }
                            ],
                            "policy": {
                                "timeout": "0.12:00:00",
                                "retry": 0,
                                "retryIntervalInSeconds": 30,
                                "secureOutput": false,
                                "secureInput": false
                            },
                            "userProperties": [],
                            "linkedServiceName": {
                                "referenceName": "ls_azure_sqldb",
                                "type": "LinkedServiceReference"
                            },
                            "typeProperties": {
                                "scripts": [
                                    {
                                        "type": "Query",
                                        "text": {
                                            "value": "@concat(\n'IF EXISTS (SELECT 1 FROM FilesTable WHERE FileName = ''', replace(replace(item().name,'.json',''),'billing_','billings_'), ''')\nBEGIN\n    UPDATE FilesTable\n    SET Status = ''Bronze_Processed'',\n        UpdatedDate = GETDATE()\n    WHERE FileName = ''', replace(replace(item().name,'.json',''),'billing_','billings_'), '''\nEND\nELSE\nBEGIN\n    INSERT INTO FilesTable (FileName, BatchName, Status, CreatedDate)\n    VALUES (\n        ''', replace(replace(item().name,'.json',''),'billing_','billings_'), ''',\n        ''', replace(replace(item().name,'.json',''),'billings_',''), ''',\n        ''Bronze_Processed'', GETDATE()\n    )\nEND'\n)",
                                            "type": "Expression"
                                        }
                                    }
                                ],
                                "scriptBlockExecutionTimeout": "02:00:00"
                            }
                        },
                        {
                            "name": "sc_mark_failed",
                            "type": "Script",
                            "dependsOn": [
                                {
                                    "activity": "cp_raw_to_bronze",
                                    "dependencyConditions": [
                                        "Failed"
                                    ]
                                }
                            ],
                            "policy": {
                                "timeout": "0.12:00:00",
                                "retry": 0,
                                "retryIntervalInSeconds": 30,
                                "secureOutput": false,
                                "secureInput": false
                            },
                            "userProperties": [],
                            "linkedServiceName": {
                                "referenceName": "ls_azure_sqldb",
                                "type": "LinkedServiceReference"
                            },
                            "typeProperties": {
                                "scripts": [
                                    {
                                        "type": "Query",
                                        "text": {
                                            "value": "@concat(\n'UPDATE [dbo].[Auditlog] \nSET Status = ''Failed'', Layer = ''Bronze'', EndTime = GETDATE() \nWHERE TableName = ''Billings'' \nAND BatchName = ''', replace(item().name,'.json',''), ''''\n)",
                                            "type": "Expression"
                                        }
                                    }
                                ],
                                "scriptBlockExecutionTimeout": "02:00:00"
                            }
                        }
                    ]
                }
            },
            {
                "name": "scr_update_ControlTable",
                "type": "Script",
                "dependsOn": [
                    {
                        "activity": "fr_each_medications",
                        "dependencyConditions": [
                            "Succeeded"
                        ]
                    }
                ],
                "policy": {
                    "timeout": "0.12:00:00",
                    "retry": 0,
                    "retryIntervalInSeconds": 30,
                    "secureOutput": false,
                    "secureInput": false
                },
                "userProperties": [],
                "linkedServiceName": {
                    "referenceName": "ls_azure_sqldb",
                    "type": "LinkedServiceReference"
                },
                "typeProperties": {
                    "scripts": [
                        {
                            "type": "Query",
                            "text": {
                                "value": "UPDATE ControlTable \nSET LastProductionUpdateDate = GETDATE() \nWHERE TableName = 'Billings'",
                                "type": "Expression"
                            }
                        }
                    ],
                    "scriptBlockExecutionTimeout": "02:00:00"
                }
            }
        ],
        "folder": {
            "name": "raw_to_bronze/adls_raw_to_bronze"
        },
        "annotations": [],
        "lastPublishTime": "2026-04-13T20:25:47Z"
    },
    "type": "Microsoft.DataFactory/factories/pipelines"
}