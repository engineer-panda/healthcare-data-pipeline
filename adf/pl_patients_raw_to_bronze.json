{
    "name": "pl_patients_raw_to_bronze",
    "properties": {
        "activities": [
            {
                "name": "lk_get_bronze_history",
                "type": "Lookup",
                "dependsOn": [],
                "policy": {
                    "timeout": "0.12:00:00",
                    "retry": 0,
                    "retryIntervalInSeconds": 30,
                    "secureOutput": false,
                    "secureInput": false
                },
                "userProperties": [],
                "typeProperties": {
                    "source": {
                        "type": "AzureSqlSource",
                        "sqlReaderQuery": {
                            "value": "SELECT \nREPLACE(BatchName, '.csv','') AS BatchName\nFROM AuditLog\nWHERE Status = 'Bronze_Completed'\nAND TableName = 'Patients'",
                            "type": "Expression"
                        },
                        "queryTimeout": "02:00:00",
                        "partitionOption": "None"
                    },
                    "dataset": {
                        "referenceName": "ds_sql_control_table",
                        "type": "DatasetReference"
                    },
                    "firstRowOnly": false
                }
            },
            {
                "name": "md_list_raw_files",
                "type": "GetMetadata",
                "dependsOn": [
                    {
                        "activity": "lk_get_bronze_history",
                        "dependencyConditions": [
                            "Succeeded"
                        ]
                    }
                ],
                "policy": {
                    "timeout": "0.12:00:00",
                    "retry": 0,
                    "retryIntervalInSeconds": 30,
                    "secureOutput": false,
                    "secureInput": false
                },
                "userProperties": [],
                "typeProperties": {
                    "dataset": {
                        "referenceName": "ds_adls_generic_csv",
                        "type": "DatasetReference",
                        "parameters": {
                            "p_filename": "*",
                            "p_folder": "patient_onprem",
                            "p_container": "raw"
                        }
                    },
                    "fieldList": [
                        "childItems"
                    ],
                    "storeSettings": {
                        "type": "AzureBlobFSReadSettings",
                        "recursive": true,
                        "enablePartitionDiscovery": false
                    },
                    "formatSettings": {
                        "type": "DelimitedTextReadSettings"
                    }
                }
            },
            {
                "name": "fl_indentity_new_batches",
                "type": "Filter",
                "dependsOn": [
                    {
                        "activity": "md_list_raw_files",
                        "dependencyConditions": [
                            "Succeeded"
                        ]
                    }
                ],
                "userProperties": [],
                "typeProperties": {
                    "items": {
                        "value": "@activity('md_list_raw_files').output.childItems",
                        "type": "Expression"
                    },
                    "condition": {
                        "value": "@not(\n    contains(\n        string(activity('lk_get_bronze_history').output.value),\n        replace(item().name,'.csv','')\n    )\n)",
                        "type": "Expression"
                    }
                }
            },
            {
                "name": "fr_each_medications",
                "type": "ForEach",
                "dependsOn": [
                    {
                        "activity": "fl_indentity_new_batches",
                        "dependencyConditions": [
                            "Succeeded"
                        ]
                    }
                ],
                "userProperties": [],
                "typeProperties": {
                    "items": {
                        "value": "@activity('fl_indentity_new_batches').output.value",
                        "type": "Expression"
                    },
                    "activities": [
                        {
                            "name": "sc_log_start",
                            "type": "Script",
                            "dependsOn": [],
                            "policy": {
                                "timeout": "0.12:00:00",
                                "retry": 0,
                                "retryIntervalInSeconds": 30,
                                "secureOutput": false,
                                "secureInput": false
                            },
                            "userProperties": [],
                            "linkedServiceName": {
                                "referenceName": "ls_azure_sqldb",
                                "type": "LinkedServiceReference"
                            },
                            "typeProperties": {
                                "scripts": [
                                    {
                                        "type": "Query",
                                        "text": {
                                            "value": "@concat(\n'IF EXISTS (\n    SELECT 1 FROM AuditLog \n    WHERE TableName = ''Patients''\n    AND BatchName = ''', replace(item().name,'.csv',''), '''\n)\nBEGIN\n    UPDATE AuditLog\n    SET Status = ''InProgress'', \n        StartTime = GETDATE()\n    WHERE TableName = ''Patients''\n    AND BatchName = ''', replace(item().name,'.csv',''), '''\nEND\nELSE\nBEGIN\n    INSERT INTO AuditLog (TableName, BatchName, Status, Layer, StartTime)\n    VALUES (\n        ''Patients'',\n        ''', replace(item().name,'.csv',''), ''',\n        ''InProgress'',\n        ''Bronze'',\n        GETDATE()\n    )\nEND'\n)",
                                            "type": "Expression"
                                        }
                                    }
                                ],
                                "scriptBlockExecutionTimeout": "02:00:00"
                            }
                        },
                        {
                            "name": "cp_raw_to_bronze",
                            "type": "Copy",
                            "dependsOn": [
                                {
                                    "activity": "sc_log_start",
                                    "dependencyConditions": [
                                        "Succeeded"
                                    ]
                                }
                            ],
                            "policy": {
                                "timeout": "0.12:00:00",
                                "retry": 0,
                                "retryIntervalInSeconds": 30,
                                "secureOutput": false,
                                "secureInput": false
                            },
                            "userProperties": [],
                            "typeProperties": {
                                "source": {
                                    "type": "DelimitedTextSource",
                                    "storeSettings": {
                                        "type": "AzureBlobFSReadSettings",
                                        "recursive": true,
                                        "enablePartitionDiscovery": false
                                    },
                                    "formatSettings": {
                                        "type": "DelimitedTextReadSettings"
                                    }
                                },
                                "sink": {
                                    "type": "ParquetSink",
                                    "storeSettings": {
                                        "type": "AzureBlobFSWriteSettings"
                                    },
                                    "formatSettings": {
                                        "type": "ParquetWriteSettings"
                                    }
                                },
                                "enableStaging": false,
                                "translator": {
                                    "type": "TabularTranslator",
                                    "typeConversion": true,
                                    "typeConversionSettings": {
                                        "allowDataTruncation": true,
                                        "treatBooleanAsNumber": false
                                    }
                                }
                            },
                            "inputs": [
                                {
                                    "referenceName": "ds_adls_generic_csv",
                                    "type": "DatasetReference",
                                    "parameters": {
                                        "p_filename": "@item().name",
                                        "p_folder": "patient_onprem",
                                        "p_container": "raw"
                                    }
                                }
                            ],
                            "outputs": [
                                {
                                    "referenceName": "ds_generic_parquet",
                                    "type": "DatasetReference",
                                    "parameters": {
                                        "p_container": "bronze",
                                        "p_folder": "patients",
                                        "p_filename": {
                                            "value": "@replace(item().name, '.csv', '.parquet')",
                                            "type": "Expression"
                                        }
                                    }
                                }
                            ]
                        },
                        {
                            "name": "sc_update_bronze_status",
                            "type": "Script",
                            "dependsOn": [
                                {
                                    "activity": "cp_raw_to_bronze",
                                    "dependencyConditions": [
                                        "Succeeded"
                                    ]
                                }
                            ],
                            "policy": {
                                "timeout": "0.12:00:00",
                                "retry": 0,
                                "retryIntervalInSeconds": 30,
                                "secureOutput": false,
                                "secureInput": false
                            },
                            "userProperties": [],
                            "linkedServiceName": {
                                "referenceName": "ls_azure_sqldb",
                                "type": "LinkedServiceReference"
                            },
                            "typeProperties": {
                                "scripts": [
                                    {
                                        "type": "Query",
                                        "text": {
                                            "value": "@concat(\n'UPDATE [dbo].[Auditlog]\nSET Status = ''Bronze_Completed'', EndTime = GETDATE()\nWHERE TableName = ''Patients''\nAND Layer = ''Bronze''\nAND BatchName = ''',\nreplace(item().name, '.csv', ''),\n''''\n)",
                                            "type": "Expression"
                                        }
                                    }
                                ],
                                "scriptBlockExecutionTimeout": "02:00:00"
                            }
                        },
                        {
                            "name": "sc_mark_processed",
                            "type": "Script",
                            "dependsOn": [
                                {
                                    "activity": "sc_update_bronze_status",
                                    "dependencyConditions": [
                                        "Succeeded"
                                    ]
                                }
                            ],
                            "policy": {
                                "timeout": "0.12:00:00",
                                "retry": 0,
                                "retryIntervalInSeconds": 30,
                                "secureOutput": false,
                                "secureInput": false
                            },
                            "userProperties": [],
                            "linkedServiceName": {
                                "referenceName": "ls_azure_sqldb",
                                "type": "LinkedServiceReference"
                            },
                            "typeProperties": {
                                "scripts": [
                                    {
                                        "type": "Query",
                                        "text": {
                                            "value": "@concat(\n'IF EXISTS (\n    SELECT 1 FROM FilesTable \n    WHERE LOWER(FileName) = LOWER(''', replace(item().name,'.csv',''), ''')\n)\nBEGIN\n    UPDATE FilesTable\n    SET Status = ''Bronze_Processed'',\n        UpdatedDate = GETDATE()\n    WHERE LOWER(FileName) = LOWER(''', replace(item().name,'.csv',''), ''')\nEND\nELSE\nBEGIN\n    INSERT INTO FilesTable (FileName, Status, CreatedDate)\n    VALUES (\n        ''', replace(item().name,'.csv',''), ''',\n        ''Bronze_Processed'',\n        GETDATE()\n    )\nEND'\n)",
                                            "type": "Expression"
                                        }
                                    }
                                ],
                                "scriptBlockExecutionTimeout": "02:00:00"
                            }
                        },
                        {
                            "name": "scr_error_log",
                            "type": "Script",
                            "dependsOn": [
                                {
                                    "activity": "cp_raw_to_bronze",
                                    "dependencyConditions": [
                                        "Failed"
                                    ]
                                }
                            ],
                            "policy": {
                                "timeout": "0.12:00:00",
                                "retry": 0,
                                "retryIntervalInSeconds": 30,
                                "secureOutput": false,
                                "secureInput": false
                            },
                            "userProperties": [],
                            "linkedServiceName": {
                                "referenceName": "ls_azure_sqldb",
                                "type": "LinkedServiceReference"
                            },
                            "typeProperties": {
                                "scripts": [
                                    {
                                        "type": "Query",
                                        "text": {
                                            "value": "@concat(\n'UPDATE AuditLog\nSET Status = ''Failed'', EndTime = GETDATE()\nWHERE BatchName = ''',\nreplace(item().name, '.csv', ''),\n'''\nAND TableName = ''Patients'''\n)",
                                            "type": "Expression"
                                        }
                                    }
                                ],
                                "scriptBlockExecutionTimeout": "02:00:00"
                            }
                        },
                        {
                            "name": "sc_mark_failed_files",
                            "type": "Script",
                            "dependsOn": [
                                {
                                    "activity": "cp_raw_to_bronze",
                                    "dependencyConditions": [
                                        "Failed"
                                    ]
                                }
                            ],
                            "policy": {
                                "timeout": "0.12:00:00",
                                "retry": 0,
                                "retryIntervalInSeconds": 30,
                                "secureOutput": false,
                                "secureInput": false
                            },
                            "userProperties": [],
                            "linkedServiceName": {
                                "referenceName": "ls_azure_sqldb",
                                "type": "LinkedServiceReference"
                            },
                            "typeProperties": {
                                "scripts": [
                                    {
                                        "type": "Query",
                                        "text": {
                                            "value": "@concat(\n'UPDATE FilesTable \nSET Status = ''Failed'', \n    UpdatedDate = GETDATE()\nWHERE LOWER(FileName) = LOWER(''', replace(item().name,'.csv',''), ''')'\n)",
                                            "type": "Expression"
                                        }
                                    }
                                ],
                                "scriptBlockExecutionTimeout": "02:00:00"
                            }
                        }
                    ]
                }
            },
            {
                "name": "scr_update_ControlTable",
                "type": "Script",
                "dependsOn": [
                    {
                        "activity": "fr_each_medications",
                        "dependencyConditions": [
                            "Succeeded"
                        ]
                    }
                ],
                "policy": {
                    "timeout": "0.12:00:00",
                    "retry": 0,
                    "retryIntervalInSeconds": 30,
                    "secureOutput": false,
                    "secureInput": false
                },
                "userProperties": [],
                "linkedServiceName": {
                    "referenceName": "ls_azure_sqldb",
                    "type": "LinkedServiceReference"
                },
                "typeProperties": {
                    "scripts": [
                        {
                            "type": "Query",
                            "text": "UPDATE ControlTable \nSET LastProductionUpdateDate = GETDATE() \nWHERE TableName = 'Patients'"
                        }
                    ],
                    "scriptBlockExecutionTimeout": "02:00:00"
                }
            }
        ],
        "folder": {
            "name": "raw_to_bronze/adls_raw_to_bronze"
        },
        "annotations": [],
        "lastPublishTime": "2026-04-13T20:40:12Z"
    },
    "type": "Microsoft.DataFactory/factories/pipelines"
}